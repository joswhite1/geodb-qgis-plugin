 <LayoutItem excludeFromExports="0" visibility="1" marginX="0" size="108.319,62.3961,mm" outlineWidthM="0.3,mm" position="8.53809,106.259,mm" halign="1" positionLock="false" valign="32" blendMode="0" labelText="Bearings and distances between corners: all claims from NCB 1 to NCB 56, except NCB 28 and NCB 32: From corner 1, the SE corner, go 1500' west to corner 2, then 600' north to corner 3, then 1500' east to corner 4, then 600' south back to corner 1.&#xa;&#xa;For NCB 57 to NCB 65: From corner 1, the SW corner, go 1500' north to corner 2, then 600' east to corner 3, then 1500' south to corner 4, then 600' west, back to corner 1.&#xa;&#xa;NCB 32: From corner 1, the SE corner, go 1500' west to corner 2, then go 305' north to corner 3, then 1500' east to corner 4, then 305' south back to corner 1.&#xa;&#xa;NCB 28: from corner 1, the SW corner, go 1500' north to corner 2, then 330' east to corner 3, then 1500' south to corner 4, then 330' west back to corner 1.  " zValue="19" referencePoint="0" opacity="1" positionOnPage="8.53809,106.259,mm" htmlState="0" id="" frameJoinStyle="miter" frame="true" templateUuid="{6ebd360e-db5a-4f35-a337-6ad74795380e}" type="65641" itemRotation="0" uuid="{6ebd360e-db5a-4f35-a337-6ad74795380e}" marginY="0" groupUuid="" background="true">
